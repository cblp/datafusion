# Tests for datafusion.optimizer.enable_parquet_late_materialization

statement ok
COPY (
  SELECT v AS id, (v * 7919) % 100003 AS k, 'url_' || (v % 97) AS url,
         'title_' || v AS title, v * 2 AS a
  FROM generate_series(0, 29999) t(v)
)
TO 'test_files/scratch/parquet_late_materialization/t.parquet'
STORED AS PARQUET OPTIONS ('format.max_row_group_size' '5000');

statement ok
CREATE EXTERNAL TABLE t STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_late_materialization/t.parquet';

statement ok
SET datafusion.optimizer.enable_parquet_late_materialization = true;

query TT
EXPLAIN SELECT * FROM t WHERE url LIKE '%_1%' ORDER BY k LIMIT 3;
----
logical_plan
01)Sort: t.k ASC NULLS LAST, fetch=3
02)--Filter: t.url LIKE Utf8View("%_1%")
03)----TableScan: t projection=[id, k, url, title, a], partial_filters=[t.url LIKE Utf8View("%_1%")]
physical_plan
01)ParquetFetchByRowIdExec: fetch=3, columns=5
02)--SortPreservingMergeExec: [k@0 ASC NULLS LAST], fetch=3
03)----SortExec: TopK(fetch=3), expr=[k@0 ASC NULLS LAST], preserve_partitioning=[true]
04)------FilterExec: url@1 LIKE %_1%
05)--------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
06)----------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_late_materialization/t.parquet]]}, projection=[k, url, CAST(__datafusion_file_row_index@5 AS Int64) as __late_materialization_row_index], file_type=parquet, predicate=url@2 LIKE %_1% AND DynamicFilter [ empty ], dynamic_rg_pruning=eligible

# Results must match the plan without late materialization (checked again at
# the end of this file with the rewrite disabled).
query IITTI
SELECT * FROM t WHERE url LIKE '%_1%' ORDER BY k, id LIMIT 7;
----
20483 11 url_16 title_20483 40966
15116 13 url_81 title_15116 30232
4382 17 url_17 title_4382 8764
19498 30 url_1 title_19498 38996
23880 47 url_18 title_23880 47760
13146 51 url_51 title_13146 26292
7779 53 url_19 title_7779 15558

query IITTI
SELECT * FROM t ORDER BY k DESC, id LIMIT 3;
----
5367 100001 url_32 title_5367 10734
10734 99999 url_64 title_10734 21468
16101 99997 url_96 title_16101 32202

# Only the selected columns are fetched.
query TI
SELECT title, k FROM t ORDER BY k LIMIT 2;
----
title_0 0
title_25850 9

# No row passes the filter
query IITTI
SELECT * FROM t WHERE url = 'nope' ORDER BY k LIMIT 5;
----

# Larger limits than late_materialization_max_rows are not rewritten
statement ok
SET datafusion.optimizer.late_materialization_max_rows = 2;

query TT
EXPLAIN SELECT * FROM t ORDER BY k LIMIT 3;
----
logical_plan
01)Sort: t.k ASC NULLS LAST, fetch=3
02)--TableScan: t projection=[id, k, url, title, a]
physical_plan
01)SortExec: TopK(fetch=3), expr=[k@1 ASC NULLS LAST], preserve_partitioning=[false]
02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_late_materialization/t.parquet]]}, projection=[id, k, url, title, a], file_type=parquet, predicate=DynamicFilter [ empty ], sort_order_for_reorder=[k@1 ASC NULLS LAST], dynamic_rg_pruning=eligible

statement ok
RESET datafusion.optimizer.late_materialization_max_rows;

# The column read late (id, 8 bytes per row) is a smaller share of the scanned
# bytes than late_materialization_min_saved_bytes_ratio (0.7 by default) next
# to the sort column (title): not rewritten
query TT
EXPLAIN SELECT id, title FROM t ORDER BY title LIMIT 3;
----
logical_plan
01)Sort: t.title ASC NULLS LAST, fetch=3
02)--TableScan: t projection=[id, title]
physical_plan
01)SortExec: TopK(fetch=3), expr=[title@1 ASC NULLS LAST], preserve_partitioning=[false]
02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_late_materialization/t.parquet]]}, projection=[id, title], file_type=parquet, predicate=DynamicFilter [ empty ], sort_order_for_reorder=[title@1 ASC NULLS LAST], dynamic_rg_pruning=eligible

statement ok
SET datafusion.optimizer.late_materialization_min_saved_bytes_ratio = 0;

query TT
EXPLAIN SELECT id, title FROM t ORDER BY title LIMIT 3;
----
logical_plan
01)Sort: t.title ASC NULLS LAST, fetch=3
02)--TableScan: t projection=[id, title]
physical_plan
01)ParquetFetchByRowIdExec: fetch=3, columns=2
02)--SortExec: TopK(fetch=3), expr=[title@0 ASC NULLS LAST], preserve_partitioning=[false]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_late_materialization/t.parquet]]}, projection=[title, CAST(__datafusion_file_row_index@5 AS Int64) as __late_materialization_row_index], file_type=parquet, predicate=DynamicFilter [ empty ], sort_order_for_reorder=[title@1 ASC NULLS LAST], dynamic_rg_pruning=eligible

query IT
SELECT id, title FROM t ORDER BY title LIMIT 3;
----
0 title_0
1 title_1
10 title_10

statement ok
RESET datafusion.optimizer.late_materialization_min_saved_bytes_ratio;

# With filter pushdown the filter on title runs inside the scan: the narrow
# scan still reads title, so only id is saved and the TopK is not rewritten
statement ok
SET datafusion.execution.parquet.pushdown_filters = true;

query TT
EXPLAIN SELECT k, title, id FROM t WHERE title LIKE '%1%' ORDER BY k LIMIT 3;
----
logical_plan
01)Sort: t.k ASC NULLS LAST, fetch=3
02)--Projection: t.k, t.title, t.id
03)----Filter: t.title LIKE Utf8View("%1%")
04)------TableScan: t projection=[id, k, title], partial_filters=[t.title LIKE Utf8View("%1%")]
physical_plan
01)ProjectionExec: expr=[k@1 as k, title@2 as title, id@0 as id]
02)--SortExec: TopK(fetch=3), expr=[k@1 ASC NULLS LAST], preserve_partitioning=[false]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_late_materialization/t.parquet]]}, projection=[id, k, title], file_type=parquet, predicate=title@3 LIKE %1% AND DynamicFilter [ empty ], sort_order_for_reorder=[k@1 ASC NULLS LAST], dynamic_rg_pruning=eligible

# Rewritten when any saving is enough
statement ok
SET datafusion.optimizer.late_materialization_min_saved_bytes_ratio = 0;

query TT
EXPLAIN SELECT k, title, id FROM t WHERE title LIKE '%1%' ORDER BY k LIMIT 3;
----
logical_plan
01)Sort: t.k ASC NULLS LAST, fetch=3
02)--Projection: t.k, t.title, t.id
03)----Filter: t.title LIKE Utf8View("%1%")
04)------TableScan: t projection=[id, k, title], partial_filters=[t.title LIKE Utf8View("%1%")]
physical_plan
01)ProjectionExec: expr=[k@1 as k, title@2 as title, id@0 as id]
02)--ParquetFetchByRowIdExec: fetch=3, columns=3
03)----SortExec: TopK(fetch=3), expr=[k@0 ASC NULLS LAST], preserve_partitioning=[false]
04)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_late_materialization/t.parquet]]}, projection=[k, CAST(__datafusion_file_row_index@5 AS Int64) as __late_materialization_row_index], file_type=parquet, predicate=title@3 LIKE %1% AND DynamicFilter [ empty ], sort_order_for_reorder=[k@1 ASC NULLS LAST], dynamic_rg_pruning=eligible

statement ok
RESET datafusion.optimizer.late_materialization_min_saved_bytes_ratio;

statement ok
RESET datafusion.execution.parquet.pushdown_filters;

# Same results with the rewrite disabled
statement ok
SET datafusion.optimizer.enable_parquet_late_materialization = false;

query IITTI
SELECT * FROM t WHERE url LIKE '%_1%' ORDER BY k, id LIMIT 7;
----
20483 11 url_16 title_20483 40966
15116 13 url_81 title_15116 30232
4382 17 url_17 title_4382 8764
19498 30 url_1 title_19498 38996
23880 47 url_18 title_23880 47760
13146 51 url_51 title_13146 26292
7779 53 url_19 title_7779 15558

statement ok
RESET datafusion.optimizer.enable_parquet_late_materialization;

statement ok
DROP TABLE t;
